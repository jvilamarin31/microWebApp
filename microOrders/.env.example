# Credenciales de ejemplo - copia este archivo a .env y ajusta los valores
# NO subas el archivo .env real al repositorio.

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=orders_db

# URL base del microservicio de productos (debe coincidir con la IP/puerto donde corre)
PRODUCTS_SERVICE_URL=http://localhost:5003

# Clave para firmar la sesion (debe coincidir con la de microUsers)
SECRET_KEY=secret123

# Configuración de Consul (opcional para ejecución local fuera de Docker)
CONSUL_HOST=localhost
CONSUL_PORT=8500

