# Variables globales para docker-compose.
# Copia este archivo a .env (la raiz del proyecto) y ajusta los valores.
# docker compose lee .env automaticamente para interpolar ${...} del docker-compose.yml.
# NO subas el archivo .env real al repositorio.

# Password del usuario root de los tres contenedores MySQL
MYSQL_ROOT_PASSWORD=root

# Usuario/app que usan los microservicios para conectar a SU base de datos
# (se crea automaticamente en cada contenedor MySQL con permisos solo sobre su BD)
DB_USER=app
DB_PASSWORD=app_password

# Clave para firmar la sesion (debe ser la misma en frontend, microUsers y microOrders)
SECRET_KEY=secret123

# Puerto publicado del frontend en el host
FRONTEND_PORT=8080
