# URLs de los microservicios usadas por el PROXY del frontend (lado servidor).
# El navegador solo habla con el frontend usando rutas relativas /api/...;
# el frontend reenvia cada /api/* al microservicio correspondiente con estas URLs.
# Copia este archivo a .env y ajusta los valores segun tu entorno:
#   - Sin Docker (todo en el host): http://localhost:5002, 5003 y 5004
#   - Con Docker: docker-compose inyecta http://microusers:5002,
#     http://microproducts:5003 y http://microorders:5004 (red interna).
# NO subas el archivo .env real al repositorio.

USERS_SERVICE_URL=http://localhost:5002
PRODUCTS_SERVICE_URL=http://localhost:5003
ORDERS_SERVICE_URL=http://localhost:5004
